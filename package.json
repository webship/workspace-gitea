{
  "name": "@webship.co/workspace-gitea",
  "version": "1.0.0",
  "description": "Gitea and Forgejo for Webship Workspace: one plugin for both (Forgejo is the fork of Gitea that keeps its API). The builder (`cmd-gitea-project.sh --product gitea|forgejo`, a site of the self-hosted Git forge from the product's own image on the project's own PostgreSQL, in containers: DDEV by default, Docker Compose too, with the default accounts, a private sample repository, its issues and milestone) and its tool in every sites folder, the step pack wired into the testing setup, the forge family's menu for a project whose remote is on your own Gitea or Forgejo, its issues as work items of the tracker family (list, read, analyze, and do the work with the workspace's AI CLI on a branch with its pull request; comments, time, close and reopen, assignees after a person's click, writes off by default), and its AI items in their folders.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-gitea.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "gitea",
    "label": "Gitea",
    "summary": "Gitea and Forgejo: a builder with a sample repository, the forge for your own instance, and its issues as work items",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "typeActions": {
      "gitea": [
        "sites",
        "code"
      ]
    },
    "settingsFile": "plugin.gitea.settings.yml",
    "settingsTemplate": "config/plugin.gitea.settings.yml",
    "labels": "config/settings.labels.yml",
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-gitea-project.sh",
        "commands/cmd-tools-gitea-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-gitea.sh"
      ],
      "args": [
        "scripts/args/arg-gitea.sh",
        "scripts/args/arg-gitea-cli.sh"
      ],
      "machine": [
        "scripts/docker-compose.gitea.yaml",
        "scripts/gitea-site.py",
        "scripts/gitea-serve.sh",
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/gitea-site-builder.md",
        "ai/agents/gitea-tester.md",
        "ai/agents/gitea-issue-worker.md"
      ],
      "skills": [
        "ai/skills/gitea-scenarios"
      ],
      "commands": [
        "ai/commands/gitea-test.md"
      ],
      "prompts": [
        "ai/prompts/gitea-build-and-test.md",
        "ai/prompts/gitea-issue-to-branch.md"
      ]
    },
    "features": [
      "features/gitea.feature",
      "features/gitea-runtimes.feature"
    ],
    "featuresSite": "cmd-gitea-project.sh ci-gitea --install --add-users --sample-content --runtime docker"
  },
  "dependencies": {
    "@webship.co/workspace-forge": "^1.0.11",
    "@webship.co/workspace-tracker": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.11",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
